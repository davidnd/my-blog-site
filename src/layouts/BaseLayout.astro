---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "David Nguyen",
  description = "Notes on software, systems, and the things I am learning.",
} = Astro.props;

const pageTitle = title === "David Nguyen" ? title : `${title} | David Nguyen`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="nMH_nou9tCnBlWYeaEvoWZPPuIHw6_VASkph64sBhvQ" />
    <meta name="google-site-verification" content="MS-rtO3bNWKHa4hVI0B5sC0pxG9MMKx-LrRwiRA6aXY" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href="/">David Nguyen</a>
        <nav class="site-nav">
          <a href="/games/">I'm feeling lucky</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <span>David Nguyen</span>
        <span class="foot-heart" aria-hidden="true">♡</span>
        <span>Da Nang, Vietnam</span>
        <span class="foot-heart" aria-hidden="true">♡</span>
        <a
          class="foot-link"
          href="https://www.linkedin.com/in/davidnd"
          target="_blank"
          rel="noopener">LinkedIn</a
        >
      </footer>
    </div>
  </body>
</html>

<style>
  /* Mirrors the footer on the front and tag pages. */
  .foot {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 13px;
    color: var(--faint);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
  }
  .foot-heart {
    color: var(--faint);
    font-size: 13px;
    margin: 0 -4px;
  }
  .foot-link {
    margin-left: 0;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .foot-link:hover {
    color: var(--accent);
  }
</style>
