---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "David Nguyen",
  description = "Notes on software, systems, and the things I am learning.",
} = Astro.props;

const pageTitle = title === "David Nguyen" ? title : `${title} | David Nguyen`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href="/">David Nguyen</a>
        <nav aria-label="Primary navigation">
          <a href="https://www.linkedin.com/in/davidnd" target="_blank">LinkedIn</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <span>David Nguyen</span>
        <span class="foot-heart" aria-hidden="true">♥️</span>
        <span>Da Nang, Vietnam</span>
      </footer>
    </div>
  </body>
</html>

<style>
  /* Mirrors the footer on the front and tag pages. */
  .foot {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 13px;
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .foot-heart {
    color: #e11d48;
    opacity: 1;
    margin: 0 -6px;
  }
</style>
