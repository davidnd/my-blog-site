---
import "../styles/global.css";
import { getPublishedPosts, tagSlug } from "../lib/posts";

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;

// Group the remaining posts by year (descending). `rest` is already sorted
// newest-first, so each year's list keeps that order.
const archive = new Map<number, typeof rest>();
for (const post of rest) {
  const year = post.data.pubDate.getFullYear();
  if (!archive.has(year)) archive.set(year, []);
  archive.get(year)!.push(post);
}
const years = [...archive.keys()].sort((a, b) => b - a);

const longDate = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const shortDate = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
});

const postHref = (post: (typeof posts)[number]) => `/blog/${post.id}/`;
const iso = (date: Date) => date.toISOString();

const pageDescription =
  "Notes on software, systems, and the things I am learning.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>David Nguyen</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href="/rss.xml"
    />
  </head>
  <body>
    <div class="wrap">
      <header class="mast">
        <a class="mast-name" href="/">David Nguyen</a>
        <nav class="mast-nav">
          <a
            class="mast-rss"
            href="https://www.linkedin.com/in/davidnd"
            target="_blank"
          >
            LinkedIn
          </a>
          <a class="mast-rss" href="/rss.xml">RSS</a>
        </nav>
      </header>

      <div class="lede">
        <h1 class="blog-title">Life notes</h1>
        <p class="blog-sub">
          A collection of thoughts, experiences, and life updates.
        </p>
      </div>

      {
        featured && (
          <article class="feat">
            <span class="feat-kicker">Latest</span>
            <h2 class="feat-title">
              <a class="feat-link" href={postHref(featured)}>
                {featured.data.title}
              </a>
            </h2>
            <p class="feat-desc">{featured.data.description}</p>
            <div class="feat-meta">
              <time datetime={iso(featured.data.pubDate)}>
                {longDate.format(featured.data.pubDate)}
              </time>
              {featured.data.tags.length > 0 && (
                <span class="feat-tags">
                  {featured.data.tags.map((tag) => (
                    <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                      {tag}
                    </a>
                  ))}
                </span>
              )}
            </div>
          </article>
        )
      }

      {
        rest.length > 0 && (
          <>
            <div class="more-label">More posts</div>
            {years.map((year) => (
              <section class="arc-year">
                <div class="arc-yearlabel">{year}</div>
                <ul class="arc-list">
                  {archive.get(year)!.map((post) => (
                    <li>
                      <a class="arc-link" href={postHref(post)}>
                        <time class="arc-date" datetime={iso(post.data.pubDate)}>
                          {shortDate.format(post.data.pubDate)}
                        </time>
                        <span class="arc-title">{post.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </>
        )
      }

      {
        posts.length === 0 && (
          <p class="empty">No posts yet — check back soon.</p>
        )
      }

      <footer class="foot">
        <span>David Nguyen</span>
        <span class="foot-dot">·</span>
        <span>Da Nang, Vietnam</span>
      </footer>
    </div>
  </body>
</html>

<style>
  .wrap {
    width: 632px;
    max-width: calc(100% - 48px);
    margin: 0 auto;
    padding: 64px 0 48px;
  }

  /* ---------- masthead ---------- */
  .mast {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 56px;
  }
  .mast-name {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .mast-rss {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .mast-rss:hover {
    color: var(--accent);
  }
  .mast-nav {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  /* ---------- lede ---------- */
  .lede {
    margin-bottom: 40px;
  }
  .blog-title {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 44px;
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
  }
  .blog-sub {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    max-width: 46ch;
  }

  /* ---------- featured (latest) ---------- */
  .feat {
    display: block;
    position: relative;
    padding: 28px;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--tint);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .feat:hover {
    border-color: var(--rule-strong);
    background: var(--tint-2);
  }
  /* Stretched link: the title's <a> covers the whole card so the entire
     card navigates to the post, while the tag links (z-indexed above) stay
     independently clickable. */
  .feat-link {
    color: inherit;
    text-decoration: none;
  }
  .feat-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 14px;
  }
  .feat-kicker {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .feat-title {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: 12px 0 0;
  }
  .feat-desc {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.5;
    color: var(--muted);
    margin: 12px 0 0;
    max-width: 50ch;
  }
  .feat-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--faint);
  }
  .feat-tags {
    display: flex;
    gap: 8px;
  }
  .tag {
    position: relative;
    z-index: 1;
    font-family: var(--sans);
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 3px 11px;
    line-height: 1;
    text-decoration: none;
    transition:
      color 0.13s ease,
      border-color 0.13s ease;
  }
  .tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---------- more posts label ---------- */
  .more-label {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 40px 0 6px;
  }

  /* ---------- archive (year-grouped, compact) ---------- */
  .arc-year {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 0 28px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .arc-year:first-of-type {
    border-top: 1px solid var(--rule-strong);
  }
  .arc-yearlabel {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    padding-top: 12px;
  }
  .arc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .arc-link {
    display: flex;
    align-items: baseline;
    gap: 20px;
    text-decoration: none;
    color: inherit;
    padding: 9px 12px;
    margin: 0 -12px;
    border-radius: 7px;
    transition: background 0.13s ease;
  }
  .arc-link:hover {
    background: var(--tint);
  }
  .arc-date {
    font-family: var(--sans);
    font-size: 13.5px;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
    width: 58px;
    flex-shrink: 0;
  }
  .arc-title {
    font-family: var(--slab);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      text-decoration-color 0.13s ease,
      color 0.13s ease;
  }
  .arc-link:hover .arc-title {
    color: var(--accent);
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }

  /* ---------- empty state ---------- */
  .empty {
    font-family: var(--serif);
    font-size: 18px;
    color: var(--muted);
  }

  /* ---------- footer ---------- */
  .foot {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 13px;
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .foot a {
    color: var(--muted);
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--accent);
  }
  .foot-dot {
    color: var(--rule-strong);
    margin: 0 -6px;
  }

  /* ---------- focus ---------- */
  .mast-name:focus-visible,
  .mast-rss:focus-visible,
  .feat-link:focus-visible,
  .tag:focus-visible,
  .arc-link:focus-visible,
  .foot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 520px) {
    .wrap {
      padding: 40px 0 36px;
    }
    .mast {
      padding-bottom: 40px;
    }
    .blog-title {
      font-size: 34px;
    }
    .blog-sub {
      font-size: 16.5px;
    }
    .feat {
      padding: 22px;
      border-radius: 12px;
    }
    .feat-title {
      font-size: 25px;
    }
    .feat-desc {
      font-size: 16.5px;
    }
    .arc-year {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .arc-yearlabel {
      padding-top: 14px;
      padding-bottom: 2px;
    }
  }
</style>
