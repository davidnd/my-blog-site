---
import "../../styles/global.css";
import { getPublishedPosts, tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  // One page per unique tag slug; posts stay newest-first from getPublishedPosts.
  const byTag = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      if (!byTag.has(slug)) byTag.set(slug, { tag, posts: [] });
      byTag.get(slug)!.posts.push(post);
    }
  }

  return [...byTag.entries()].map(([slug, { tag, posts }]) => ({
    params: { tag: slug },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;

// Group by year (descending), mirroring the front page archive.
const archive = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!archive.has(year)) archive.set(year, []);
  archive.get(year)!.push(post);
}
const years = [...archive.keys()].sort((a, b) => b - a);

const shortDate = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
});

const postHref = (post: (typeof posts)[number]) => `/blog/${post.id}/`;
const iso = (date: Date) => date.toISOString();
const count = posts.length;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Posts tagged "${tag}".`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="nMH_nou9tCnBlWYeaEvoWZPPuIHw6_VASkph64sBhvQ" />
    <meta name="google-site-verification" content="MS-rtO3bNWKHa4hVI0B5sC0pxG9MMKx-LrRwiRA6aXY" />
    <title>{`#${tag}`} | David Nguyen</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`#${tag} | David Nguyen`} />
    <meta property="og:description" content={`Posts tagged "${tag}".`} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="wrap">
      <header class="mast">
        <a class="mast-name" href="/">David Nguyen</a>
      </header>

      <a class="back" href="/">
        <svg
          class="back__arrow"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M9.5 3.5L5 8l4.5 4.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>All posts</span>
      </a>

      <div class="lede">
        <h1 class="blog-title">#{tag}</h1>
        <p class="blog-sub">
          {count} {count === 1 ? "post" : "posts"} tagged “{tag}”.
        </p>
      </div>

      {
        years.map((year) => (
          <section class="arc-year">
            <div class="arc-yearlabel">{year}</div>
            <ul class="arc-list">
              {archive.get(year)!.map((post) => (
                <li>
                  <a class="arc-link" href={postHref(post)}>
                    <time class="arc-date" datetime={iso(post.data.pubDate)}>
                      {shortDate.format(post.data.pubDate)}
                    </time>
                    <span class="arc-title">{post.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <footer class="foot">
        <span>David Nguyen</span>
        <span class="foot-heart" aria-hidden="true">♡</span>
        <span>Da Nang, Vietnam</span>
        <span class="foot-heart" aria-hidden="true">♡</span>
        <a
          class="foot-link"
          href="https://www.linkedin.com/in/davidnd"
          target="_blank"
          rel="noopener"
        >
          LinkedIn
        </a>
      </footer>
    </div>
  </body>
</html>

<style>
  .wrap {
    width: 632px;
    max-width: calc(100% - 48px);
    margin: 0 auto;
    padding: 64px 0 48px;
  }

  /* ---------- masthead ---------- */
  .mast {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 40px;
  }
  .mast-name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  /* ---------- back link ---------- */
  .back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 26px;
    margin-left: -4px;
    padding: 4px 4px 4px 2px;
    border-radius: 6px;
    transition: color 0.15s ease;
  }
  .back__arrow {
    transition: transform 0.15s ease;
  }
  .back:hover {
    color: var(--accent);
  }
  .back:hover .back__arrow {
    transform: translateX(-2px);
  }

  /* ---------- lede ---------- */
  .lede {
    margin-bottom: 40px;
  }
  .blog-title {
    font-family: var(--slab);
    font-weight: 600;
    font-size: 44px;
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
  }
  .blog-sub {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    max-width: 46ch;
  }

  /* ---------- archive (year-grouped, compact) ---------- */
  .arc-year {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 0 28px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .arc-year:first-of-type {
    border-top: 1px solid var(--rule-strong);
  }
  .arc-yearlabel {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    padding-top: 12px;
  }
  .arc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .arc-link {
    display: flex;
    align-items: baseline;
    gap: 20px;
    text-decoration: none;
    color: inherit;
    padding: 9px 12px;
    margin: 0 -12px;
    border-radius: 7px;
    transition: background 0.13s ease;
  }
  .arc-link:hover {
    background: var(--tint);
  }
  .arc-date {
    font-family: var(--sans);
    font-size: 13.5px;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
    width: 58px;
    flex-shrink: 0;
  }
  .arc-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      text-decoration-color 0.13s ease,
      color 0.13s ease;
  }
  .arc-link:hover .arc-title {
    color: var(--accent);
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }

  /* ---------- footer ---------- */
  .foot {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 13px;
    color: var(--faint);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
  }
  .foot a {
    color: inherit;
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--accent);
  }
  .foot-link {
    margin-left: 0;
    transition: color 0.15s ease;
  }
  .foot-heart {
    color: var(--faint);
    font-size: 13px;
    margin: 0 -4px;
  }

  /* ---------- focus ---------- */
  .mast-name:focus-visible,
  .back:focus-visible,
  .arc-link:focus-visible,
  .foot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 520px) {
    .wrap {
      padding: 40px 0 36px;
    }
    .mast {
      padding-bottom: 32px;
    }
    .blog-title {
      font-size: 34px;
    }
    .blog-sub {
      font-size: 16.5px;
    }
    .arc-year {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .arc-yearlabel {
      padding-top: 14px;
      padding-bottom: 2px;
    }
  }
</style>
