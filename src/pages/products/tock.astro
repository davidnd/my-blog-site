---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Tock's page. The app's code lives in a private repo (davidnd/tock); its
// release script uploads each DMG and latest.json to the R2 bucket served at
// downloads.davidnd.dev. This page only reads latest.json in the browser, so a
// new release shows up here without rebuilding the blog. See RELEASE.md in the
// Tock repo.
const DOWNLOADS = "https://downloads.davidnd.dev/tock";
---

<BaseLayout
  title="Tock: menu bar reminders for Mac"
  description="Tock is a tiny reminder app for the macOS menu bar. Press ⌃⌘R, type “call mom tomorrow at 5”, and get a reminder right on time. Free, native, no account."
  image="/images/products/tock/social-preview.png"
>
  <header class="hero">
    <img class="icon" src="/images/products/tock/icon.png" alt="Tock app icon: a clock with its hands forming a check mark" width="96" height="96" />
    <div>
      <h1>Tock</h1>
      <p class="lede">A tiny reminder app for your Mac's menu bar.</p>
    </div>
  </header>

  <div class="download">
    <a class="button" id="download" href={`${DOWNLOADS}/Tock.dmg`}>Download for Mac</a>
    <p class="meta" id="download-meta">Free · macOS 13 or later · Apple Silicon and Intel</p>
  </div>

  <figure class="demo">
    <img src="/images/products/tock/demo.gif" alt="Adding a reminder with ⌃⌘R, opening the list from the menu bar, and completing a reminder from its alert card" width="1280" height="800" />
  </figure>

  <section>
    <h2>Add a reminder in two seconds</h2>
    <p>Wherever you are, press the shortcut, type what to remember and when, and get back to what you were doing.</p>
    <p class="keys"><kbd>⌃</kbd> <kbd>⌘</kbd> <kbd>R</kbd> <span>→</span> type <span>→</span> <kbd>Enter</kbd></p>
    <img class="quick" src="/images/products/tock/quick-add.png" alt="The Tock quick-add bar with “Call mom tomorrow at 5” typed in, showing Tomorrow 17:00" width="700" height="94" loading="lazy" />
    <ul class="examples">
      <li><code>Call mom tomorrow at 5</code> <span class="when">→ Tomorrow 17:00</span></li>
      <li><code>Take the tea bag out in 90s</code> <span class="when">→ in 90 seconds</span></li>
      <li><code>Team lunch this Friday at noon</code> <span class="when">→ Fri 12:00</span></li>
      <li><code>Pay rent on the 1st</code> <span class="when">→ 1st, 09:00</span></li>
    </ul>
    <dl class="facts">
      <div><dt>Plain English</dt><dd>Write the time the way you'd say it. Tock shows what it understood before you press Enter.</dd></div>
      <div><dt>Just a menu bar icon</dt><dd>No Dock icon and no window to manage. A clock in the menu bar, and that's it.</dd></div>
      <div><dt>Lightweight</dt><dd>A small native Swift app. No account, no sync, nothing sent anywhere.</dd></div>
    </dl>
  </section>

  <section>
    <h2>Install</h2>
    <ol class="steps">
      <li>Download Tock with the button above.</li>
      <li>Open the <code>.dmg</code> and drag <strong>Tock</strong> into <strong>Applications</strong>.</li>
      <li>Open Tock. Look for the clock in your menu bar, then press <kbd>⌃</kbd> <kbd>⌘</kbd> <kbd>R</kbd> to add your first reminder.</li>
    </ol>
    <p class="note">
      <strong>“Apple could not verify Tock”?</strong> This build isn't notarized yet. Open it once, then go to
      <strong>System Settings → Privacy &amp; Security</strong> and click <strong>Open Anyway</strong>. Or run this in Terminal:
      <code class="block">xattr -dr com.apple.quarantine /Applications/Tock.app</code>
    </p>
  </section>
</BaseLayout>

<script>
  // Show the newest version on the button. Without it the button still
  // downloads Tock.dmg, the copy of the newest release.
  const DOWNLOADS = "https://downloads.davidnd.dev/tock";
  fetch(`${DOWNLOADS}/latest.json`, { cache: "no-cache" })
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((latest) => {
      const button = document.getElementById("download");
      const meta = document.getElementById("download-meta");
      if (!button || !meta || !latest?.version) return;
      if (latest.url) button.setAttribute("href", latest.url);
      button.textContent = `Download Tock ${latest.version}`;
      const mb = latest.size ? `${(latest.size / 1e6).toFixed(1)} MB · ` : "";
      meta.textContent = `Free · ${mb}macOS ${String(latest.minimumMacOS ?? "13").replace(/\.0$/, "")} or later · Apple Silicon and Intel`;
    })
    .catch(() => {});
</script>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .icon {
    flex: none;
    width: 96px;
    height: 96px;
  }
  h1 {
    font-family: var(--slab);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0 0 6px;
  }
  .lede {
    margin: 0;
    color: var(--muted);
    font-size: 19px;
  }
  .download {
    margin: 28px 0 0;
  }
  .button {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 17px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .button:hover {
    background: var(--link-hover);
    color: #fff;
    transform: translateY(-1px);
  }
  .meta {
    margin: 10px 0 0;
    color: var(--faint);
    font-size: 14px;
  }
  .demo {
    margin: 36px 0 0;
  }
  .demo img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--rule);
  }
  section {
    margin-top: 48px;
  }
  h2 {
    font-family: var(--slab);
    font-size: 26px;
    font-weight: 600;
    margin: 0 0 10px;
  }
  section > p {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
    margin: 0 0 18px;
  }
  .keys {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  kbd {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    color: var(--text);
  }
  .quick {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--rule);
  }
  .examples {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    gap: 8px;
  }
  .when {
    white-space: nowrap;
    color: var(--accent);
    font-weight: 600;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px 26px;
    margin: 30px 0 0;
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.45;
  }
  .steps {
    margin: 0;
    padding-left: 22px;
    display: grid;
    gap: 8px;
  }
  .note {
    margin: 20px 0 0;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--tint-2);
    font-size: 16px;
    line-height: 1.5;
  }
  .note .block {
    display: block;
    margin-top: 8px;
    overflow-x: auto;
    white-space: nowrap;
  }
</style>
