---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Apps I make. Each has a page at /products/<slug>/ and its downloads on
// https://downloads.davidnd.dev/<slug>/ (an R2 bucket; see the app's RELEASE.md).
const products = [
  {
    name: "Tock",
    href: "/products/tock/",
    icon: "/images/products/tock/icon.png",
    platform: "macOS",
    blurb: "A tiny reminder app for your menu bar. Press a shortcut, type the reminder in plain English, get nudged on time.",
  },
];
---

<BaseLayout title="Products" description="Small apps I make and use every day.">
  <div class="intro">
    <h1>Products</h1>
    <p>Small apps I make because I wanted them. Free to download.</p>
  </div>

  <ul class="products">
    {
      products.map((p) => (
        <li>
          <a class="product" href={p.href}>
            <img src={p.icon} alt="" width="72" height="72" />
            <span class="info">
              <span class="name">
                {p.name} <span class="platform">{p.platform}</span>
              </span>
              <span class="blurb">{p.blurb}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .intro h1 {
    font-family: var(--slab);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0 0 12px;
  }
  .intro p {
    max-width: 60ch;
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
  }
  .products {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .product {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .product:hover {
    border-color: var(--accent);
  }
  .product img {
    flex: none;
    width: 72px;
    height: 72px;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .name {
    font-family: var(--slab);
    font-size: 20px;
    font-weight: 600;
  }
  .platform {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--faint);
    margin-left: 6px;
  }
  .blurb {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.45;
  }
</style>
